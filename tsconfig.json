{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["chrome", "vitest/globals", "vite/client"]
  },
  "include": [
    "src",
    "sites",
    "tests",
    "dev",
    "wxt.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
