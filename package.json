{
  "name": "corresponding",
  "version": "0.1.0",
  "private": true,
  "description": "Corresponding — local-first scientific identity and submission assistance Chrome extension.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:adapters": "vitest run tests/adapters",
    "test:fuzz": "vitest run tests/chaos tests/property",
    "test:fixtures": "vitest run tests/fixtures tests/recognition",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "vitest run tests/perf/benchmark.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:security": "eslint src tests --max-warnings 0",
    "semgrep": "semgrep --config=p/javascript --config=p/typescript --config=p/security-audit --error src",
    "security": "npm run lint:security && npm run semgrep && npm audit --audit-level=high"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^10.8.1",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.8",
    "wxt": "0.21.4"
  }
}
