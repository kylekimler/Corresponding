{
  "name": "journal-autofill",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that fills scientific manuscript submission author forms from a canonical local roster.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@wxt-dev/module-react": "^1.1.3",
    "fast-check": "^4.9.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "wxt": "^0.19.29"
  }
}
